# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chrononexia

