# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chrononexia

# Individual Database Parameters (fallback if DATABASE_URL is not provided)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chrononexia

# SSL Configuration for Database (set to true for production DB requiring SSL)
DATABASE_SSL=false

# Supabase BaaS Client Credentials (Frontend direct communication)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Modern convention: Publishable key (formerly known as anon public key)
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# Fallback support for legacy variable name:
# VITE_SUPABASE_ANON_KEY=<your-publishable-key>

